# Defaults send nothing to external services.
SAIN_ALLOW_NETWORK=0
SAIN_DATASET_PATH=examples/synthetic-dataset.json
SAIN_CONTRACT_PROFILE=contracts/profiles/local_example.json
PORT=8000
# For an actual stand, remove SAIN_DATASET_PATH, install verified official schemas
# and profile, and explicitly enable network. Organizer env supplies:
# HACK_API_URL, LLM_BASE_URL, LLM_API_KEY, LLM_MODEL.
# This file is documentation; the application does not load .env automatically.
